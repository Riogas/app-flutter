// FunciÃ³n utilitaria para abrir cajas Hive de forma segura
dynamic openBoxSafe(String boxName) async {
  try {
    if (!Hive.isBoxOpen(boxName)) {
      // Si tu versiÃ³n de Hive soporta boxExists, puedes agregar aquÃ­ la verificaciÃ³n
      // if (!await Hive.boxExists(boxName)) {
      //   print('âš ï¸ La caja $boxName no existe en disco.');
      //   return null;
      // }
      return await Hive.openBox(boxName);
    }
    return Hive.box(boxName);
  } catch (e) {
    print('âŒ Error abriendo la caja $boxName: $e');
    return null;
  }
}

class FirebaseService {
  final FirebaseFirestore _firestore = FirebaseFirestore.instance;
  User? _user;
  static int streamCount = 0;
  static Map<String, int> streamCounters = {};

  // Control para el listener de auth state
  static bool _authListenerInitialized = false;

  // Timer para refresh proactivo del token
  static Timer? _tokenRefreshTimer;

  Future<void> initializeFirebase() async {
    //WidgetsFlutterBinding.ensureInitialized();

    /*try {
      // Inicializar Firebase
      await Firebase.initializeApp();
      // print('Firebase initialized successfully');
    } catch (e) {
      // print('Error initializing Firebase: $e');
      await _logError('Firebase Initialization Error', e.toString());
    }*/

    // Cargar credenciales guardadas antes de intentar login
    await Config.loadCredentials();

    // Autenticar al usuario
    await signInWithEmailAndPassword();

    // Inicializar listener de auth state (solo una vez)
    _setupAuthStateListener();

    // Iniciar refresh proactivo del token
    startProactiveTokenRefresh();
  }

  /// Configura el listener de cambios en el estado de autenticaciÃ³n
  void _setupAuthStateListener() {
    if (_authListenerInitialized) {
      print('â„¹ï¸ [FIREBASE_SERVICE] Listener de auth ya inicializado');
      return;
    }

    FirebaseAuth.instance.authStateChanges().listen((User? user) async {
      if (user == null) {
        print('ðŸ”´ [FIREBASE_SERVICE] Usuario desautenticado o token expirado');
        print('   Timestamp: ${DateTime.now().toIso8601String()}');

        // Intentar re-autenticar si hay credenciales guardadas
        if (Config.firestoreEmail.isNotEmpty &&
            Config.firestorePassword.isNotEmpty) {
          print(
              'ðŸ”„ [FIREBASE_SERVICE] Intentando re-autenticaciÃ³n automÃ¡tica...');
          await signInWithEmailAndPassword();
        } else {
          print('âš ï¸ [FIREBASE_SERVICE] No hay credenciales para re-autenticar');
        }
      } else {
        print('âœ… [FIREBASE_SERVICE] Usuario autenticado: ${user.email}');
        print('   UID: ${user.uid}');
        print('   Timestamp: ${DateTime.now().toIso8601String()}');
        _user = user;
      }
    }, onError: (error) {
      print('âŒ [FIREBASE_SERVICE] Error en authStateChanges: $error');
    });

    _authListenerInitialized = true;
    print('âœ… [FIREBASE_SERVICE] Listener de auth state inicializado');
  }

  /// Inicia el timer para refresh proactivo del token cada 45 minutos
  /// Esto previene que el token expire (expira a la 1 hora)
  void startProactiveTokenRefresh() {
    // Cancelar timer existente si hay
    _tokenRefreshTimer?.cancel();

    // Crear nuevo timer que se ejecuta cada 45 minutos
    _tokenRefreshTimer =
        Timer.periodic(const Duration(minutes: 45), (timer) async {
      print('â° [FIREBASE_SERVICE] Timer de refresh de token ejecutado');
      print('   Timestamp: ${DateTime.now().toIso8601String()}');

      bool refreshed = await refreshAuthToken();

      if (refreshed) {
        print('âœ… [FIREBASE_SERVICE] Token refrescado proactivamente');
      } else {
        print('âŒ [FIREBASE_SERVICE] FallÃ³ el refresh proactivo del token');
      }
    });

    print(
        'âœ… [FIREBASE_SERVICE] Timer de refresh proactivo iniciado (cada 45 min)');
  }

  /// Detiene el timer de refresh proactivo
  void stopProactiveTokenRefresh() {
    _tokenRefreshTimer?.cancel();
    _tokenRefreshTimer = null;
    print('ðŸ›‘ [FIREBASE_SERVICE] Timer de refresh proactivo detenido');
  }

  /// Refresca el token del usuario actual
  /// Llama a este mÃ©todo antes de operaciones crÃ­ticas o periÃ³dicamente
  Future<bool> refreshAuthToken() async {
    try {
      final User? currentUser = FirebaseAuth.instance.currentUser;

      if (currentUser == null) {
        print(
            'âš ï¸ [FIREBASE_SERVICE] No hay usuario autenticado para refrescar token');

        // Intentar re-autenticar
        if (Config.firestoreEmail.isNotEmpty &&
            Config.firestorePassword.isNotEmpty) {
          print('ðŸ”„ [FIREBASE_SERVICE] Intentando re-autenticaciÃ³n...');
          await signInWithEmailAndPassword();
          return FirebaseAuth.instance.currentUser != null;
        }

        return false;
      }

      print(
          'ðŸ”„ [FIREBASE_SERVICE] Refrescando token para: ${currentUser.email}');

      // getIdToken(true) fuerza el refresh del token
      String? token = await currentUser.getIdToken(true);

      if (token != null) {
        print('âœ… [FIREBASE_SERVICE] Token refrescado exitosamente');
        print('   Timestamp: ${DateTime.now().toIso8601String()}');
        return true;
      } else {
        print('âŒ [FIREBASE_SERVICE] No se pudo obtener el token');
        return false;
      }
    } catch (e) {
      print('âŒ [FIREBASE_SERVICE] Error refrescando token: $e');
      await _logError('Token Refresh Error', e.toString());
      return false;
    }
  }

  /// Verifica si el usuario estÃ¡ autenticado y el token es vÃ¡lido
  /// Retorna true si estÃ¡ todo OK, false si necesita re-autenticaciÃ³n
  Future<bool> ensureAuthenticated() async {
    final User? currentUser = FirebaseAuth.instance.currentUser;

    if (currentUser == null) {
      print(
          'âš ï¸ [FIREBASE_SERVICE] Usuario no autenticado, intentando login...');
      await signInWithEmailAndPassword();
      return FirebaseAuth.instance.currentUser != null;
    }

    // Verificar si el token necesita refresh (opcional, getIdToken lo hace automÃ¡ticamente)
    try {
      String? token =
          await currentUser.getIdToken(false); // false = usa cache si es vÃ¡lido
      return token != null;
    } catch (e) {
      print('âŒ [FIREBASE_SERVICE] Error verificando autenticaciÃ³n: $e');
      // Intentar refresh
      return await refreshAuthToken();
    }
  }

  Future<void> signInWithEmailAndPassword() async {
    try {
      // Verificar que las credenciales no estÃ©n vacÃ­as
      if (Config.firestoreEmail.isEmpty || Config.firestorePassword.isEmpty) {
        print(
            'âš ï¸ [FIREBASE_SERVICE] Credenciales vacÃ­as, no se puede hacer login');
        print(
            '   Email: "${Config.firestoreEmail}", Password: "${Config.firestorePassword}"');
        await _logError('Firebase Auth Error',
            'Credenciales vacÃ­as - Usuario no ha hecho login');
        return;
      }

      print(
          'ðŸ” [FIREBASE_SERVICE] Intentando login con: ${Config.firestoreEmail}');

      UserCredential userCredential =
          await FirebaseAuth.instance.signInWithEmailAndPassword(
        email: Config.firestoreEmail, // Utiliza la variable global
        password: Config.firestorePassword, // Utiliza la variable global
      );
      _user = userCredential.user;
      print('âœ… [FIREBASE_SERVICE] Usuario autenticado: ${_user?.email}');
      // print("User signed in: ${_user?.email}");
    } on FirebaseAuthException catch (e) {
      print(
          'âŒ [FIREBASE_SERVICE] Error de autenticaciÃ³n: ${e.code} - ${e.message}');
      // print("Error signing in: $e");
      await _logError('Firebase Auth Error', e.toString());
    }
  }

